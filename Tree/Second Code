#include<iostream>
using namespace std;

class Node {
public:
    int data;
    Node *left, *right;

    Node(int val) {
        data = val;
        left = right = NULL;
    }
};

Node *Binary() {
    int x;
    
    cin >> x;   

    if(x == -1) {
        return NULL;
    }

    Node *temp = new Node(x);

    cout << "Enter the left child of " << x << " : ";
    temp->left = Binary();

    cout << "Enter the right child of " << x << " : ";
    temp->right = Binary();

    return temp;
}

int main() {
    cout << "Enter the root Node : ";
    
    Node *root;
    root = Binary();

    return 0;
}
